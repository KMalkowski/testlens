{
  "name": "testlens",
  "version": "0.1.0",
  "description": "CLI test quality lens for Next.js, React Testing Library, and Playwright repositories.",
  "type": "module",
  "bin": {
    "testlens": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "MVP.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "keywords": [
    "testing",
    "cli",
    "nextjs",
    "playwright",
    "react-testing-library"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "junit2json": "^3.2.1",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "shiki": "^4.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.19.39",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.14.0"
}
